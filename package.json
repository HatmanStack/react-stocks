{
  "name": "react-stocks-monorepo",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "cd frontend && expo start",
    "test": "jest --config frontend/jest.config.js",
    "test:backend": "cd backend && npm test",
    "test:ml": "PYTHONPATH=. pytest tests/backend/ml/test_model.py -v --tb=short",
    "lint": "cd frontend && expo lint",
    "lint:backend": "cd backend && npm run lint && npm run type-check",
    "lint:ml": "uvx ruff check backend/services/ml",
    "check": "npm run lint && npm run lint:backend && npm run lint:ml && npm run test && npm run test:backend -- --ci --forceExit && npm run test:ml",
    "deploy": "./backend/scripts/deploy.sh"
  },
  "devDependencies": {
    "knip": "^5.80.0",
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "@types/jest": "^29.5.14",
    "babel-preset-expo": "~54.0.9",
    "expo": "~54.0.30",
    "expo-constants": "~18.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.21",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.16",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-svg": "^15.12.1",
    "react-native-worklets": "^0.5.1"
  }
}
