{
  "name": "react-stocks-monorepo",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "cd frontend && expo start",
    "test": "jest --config frontend/jest.config.js",
    "test:backend": "cd backend && npm test",
    "lint": "cd frontend && expo lint",
    "lint:backend": "cd backend && npm run lint && npm run type-check",
    "lint:ml": "uvx ruff check backend/services/ml",
    "check": "npm run lint && npm run lint:backend && npm run lint:ml && npm run test && npm run test:backend -- --ci --forceExit",
    "deploy": "./backend/scripts/deploy.sh",
    "hygiene": "./scripts/code-hygiene.sh"
  },
  "devDependencies": {
    "knip": "^5.80.0"
  }
}
